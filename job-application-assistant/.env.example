# Copy this file to .env and fill in a key. NEVER commit .env.

# Which LLM to use: "ollama" (free, runs locally, no key),
# "groq" (free, API key), or "anthropic" (Claude, paid).
# Switch providers by changing ONLY this line (plus that provider's key).
LLM_PROVIDER=ollama

# --- Ollama (free, local, no key, no internet) ---
# 1) Install from https://ollama.com
# 2) Run:  ollama pull llama3.2:3b
# 3) Ollama serves automatically on localhost:11434
OLLAMA_URL=http://localhost:11434
# Small model suited to a CPU-only / low-RAM machine. Larger = better
# but slower (e.g. llama3.1:8b, qwen2.5:7b).
OLLAMA_MODEL=llama3.2:3b

# --- Groq (free): get a key at https://console.groq.com/keys ---
GROQ_API_KEY=gsk-your-groq-key-here
# Optional. Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic / Claude (paid): https://console.anthropic.com ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional. Default: claude-sonnet-4-6 (good cost/latency for 100+ jobs).
CLAUDE_MODEL=claude-sonnet-4-6

# Optional. Default: 3000
PORT=3000
