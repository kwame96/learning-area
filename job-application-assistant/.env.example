# Copy this file to .env and fill in a key. NEVER commit .env.

# Which LLM to use: "groq" (free) or "anthropic" (Claude, paid).
# Start on groq; switch to anthropic later by changing ONLY this line
# (and making sure ANTHROPIC_API_KEY below is set).
LLM_PROVIDER=groq

# --- Groq (free): get a key at https://console.groq.com/keys ---
GROQ_API_KEY=gsk-your-groq-key-here
# Optional. Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic / Claude (paid): https://console.anthropic.com ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional. Default: claude-sonnet-4-6 (good cost/latency for 100+ jobs).
CLAUDE_MODEL=claude-sonnet-4-6

# Optional. Default: 3000
PORT=3000
